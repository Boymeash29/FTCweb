# Public Supabase project values (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Local origin; set the production HTTPS origin in Vercel Production only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only; needed only by the scheduled publishing job.
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
CRON_SECRET=generate-a-long-random-secret

# Optional server-side media storage (never prefix with NEXT_PUBLIC_)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=
R2_REGION=auto

# Keep this set to the public origin in each environment.
